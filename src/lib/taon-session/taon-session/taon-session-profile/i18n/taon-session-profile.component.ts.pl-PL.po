#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:82
msgid "Change Username"
msgstr "Zmień nazwę użytkownika"

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:240
msgid "Are you sure? "
msgstr "Na pewno? "

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:241
msgid "Disconnecting provider [[ provider ]]."
msgstr "Odłączanie dostawcy [[ provider ]]."

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:244
msgid "OK"
msgstr "OK"

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:245
msgid "Cancel"
msgstr "Anuluj"

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:270
msgid "Connect a sign-in method with a verified email first."
msgstr "Najpierw połącz metodę logowania ze zweryfikowanym adresem e-mail."

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:294
msgid "Passwords do not match each other"
msgstr "Hasła nie są zgodne."

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:305
msgid "Unable to connect email/password."
msgstr "Nie można połączyć logowania przez e-mail i hasło."

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:315
msgid "Unable to connect email/password. The email may already belong to another account."
msgstr "Nie można połączyć logowania przez e-mail i hasło. Ten adres e-mail może już należeć do innego konta."

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:341
msgid "This username is already taken."
msgstr "Ta nazwa użytkownika jest już zajęta."

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:349
msgid "Unable to update username."
msgstr "Nie można zaktualizować nazwy użytkownika."

#: src/lib/taon-session/taon-session/taon-session-profile/taon-session-profile.component.ts:358
msgid "Unable to update username. It may already be taken."
msgstr "Nie można zaktualizować nazwy użytkownika. Być może jest już zajęta."
