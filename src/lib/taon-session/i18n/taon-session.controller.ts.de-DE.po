#: src/lib/taon-session/taon-session.controller.ts:486
msgid "User is not active"
msgstr "Der Benutzer ist nicht aktiv."

#: src/lib/taon-session/taon-session.controller.ts:501
msgid "Your account is blocked for [[ days ]] days. Please contact [[ administratorEmail ]] to unblock your account."
msgstr "Ihr Konto ist gesperrt. Verbleibende Sperrdauer: [[ days ]] Tage. Wenden Sie sich an [[ administratorEmail ]], um die Sperre aufzuheben."

#: src/lib/taon-session/taon-session.controller.ts:516
